# Auto detect text files and perform LF normalization
* text=auto

# Script che girano su Linux/macOS: SEMPRE fine-riga LF (CRLF rompe lo shebang)
*.sh            text eol=lf
*.desktop       text eol=lf
packaging/linux/AppRun text eol=lf

# Gli script di shell devono restare LF anche su Windows (altrimenti su Mac/Linux non partono).
*.sh text eol=lf
